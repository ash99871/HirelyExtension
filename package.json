{
  "name": "hirely-browser-extension",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs --production",
    "build:dev": "node esbuild.config.mjs --development",
    "watch": "node esbuild.config.mjs --development --watch",
    "build:web": "node scripts/sync-web-app.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pure.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@supabase/postgrest-js": "^2.117.3"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@types/chrome": "^0.0.326",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3"
  }
}
